# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# database (SQLite 开发库不入库)
/prisma/*.db
/prisma/*.db-journal
# SQLite 运行时旁写文件与数据库压缩副本 —— 生产库 807MB，绝不能入库
/prisma/*.db.gz
/prisma/*.db-wal
/prisma/*.db-shm
/prisma/migrations/dev.db*

# misc
.DS_Store
*.pem

# debug / 日志（*.log 全量忽略，运行日志与排查产物一律不入库）
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env
.env
.env*.local

# typescript
*.tsbuildinfo

# 真实行情数据源（用户自行放置，不提交）
/data/raw/
/data/*.csv
!/data/sample/*.json

# ── 凭据：含服务器明文密码，永不入库（模板见 deploy/remote.example.py）
/deploy/remote.py
/deploy/_tmp_*.py

# ── 本机环境变量（模板见 .env.example）
.env

# ── 部署中间产物与打包残渣
/.deploy-bundle/
/.deploy-delta/
/.tmp-run/
*.tar.gz
/build-standalone.log

# ── python
__pycache__/
*.pyc

# ── WorkBuddy 工作目录（会话记忆 / 验证截图等运行产物，不入库）
/.workbuddy/

# ── 一次性排查脚本与中间产物（审计/验证过程产生，不入库）
# `_` 前缀的临时脚本（python / node 探针、数据比对、故障复现等）
/_*.py
/_*.js
/_*.mjs
/_*.ts
/_*.txt
# 临时目录（阶段验证输出、抓包、合成库等）
/.tmp-*/
# 进程输出重定向与探针产物
*.err
*.out
/probe.txt
# 本次仓库初始化扫描的临时文件
/.scan-untracked.txt

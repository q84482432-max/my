[Unit]
Description=A-Share Sim Trading (Next.js)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/app
Environment=NODE_ENV=production
Environment=PORT=8080
Environment=HOSTNAME=0.0.0.0
Environment=DATABASE_URL=file:./dev.db
Environment=NODE_OPTIONS=--max-old-space-size=768
ExecStart=/usr/local/bin/node /home/ubuntu/app/node_modules/next/dist/bin/next start -p 8080 -H 0.0.0.0
Restart=always
RestartSec=5
StandardOutput=append:/home/ubuntu/app/app.log
StandardError=append:/home/ubuntu/app/app.log

[Install]
WantedBy=multi-user.target

{
  "name": "a-share-sim-trading",
  "version": "0.1.0",
  "private": true,
  "description": "A股个股模拟交易 + 行情 + 收益分析 + 历史回测 Web 应用",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "import:dry": "tsx scripts/importMarketJson.ts --dry-run",
    "import:market": "tsx scripts/importMarketJson.ts --replace",
    "test:market": "tsx scripts/testMarketData.ts",
    "test:kline": "tsx scripts/testKlineAggregation.ts",
    "test:indicators": "tsx scripts/testIndicators.ts",
    "test:chart": "tsx scripts/testKlineChartOption.ts",
    "test:trade": "tsx scripts/testTradingEngine.ts",
    "test:account": "tsx scripts/testAccountViews.ts",
    "test:sim": "tsx scripts/testSimulation.ts",
    "test:backtest": "tsx scripts/testBacktest.ts",
    "test:api": "tsx scripts/testApiRoutes.ts",
    "test:simTrade": "tsx scripts/testSimTrade.ts",
    "test:simTradeUI": "node -e \"require('./runner.mjs').run('scripts/testSimTradeUI.ts')\"",
    "test:concurrency": "tsx scripts/testConcurrency.ts",
    "test:index": "tsx scripts/testIndexIsolation.ts",
    "browser:shot": "tsx scripts/browserVerify.ts shot",
    "browser": "tsx scripts/browserVerify.ts",
    "test:all": "npm run test:market && npm run test:kline && npm run test:indicators && npm run test:chart && npm run test:trade && npm run test:account && npm run test:sim && npm run test:backtest && npm run test:simTrade && npm run test:concurrency && npm run test:index"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "lucide-react": "^1.45.0",
    "next": "^15.5.25",
    "prisma": "^6.19.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.5.6",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
